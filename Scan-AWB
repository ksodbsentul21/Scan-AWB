<script>

const API_URL =
'https://script.google.com/macros/s/AKfycbwvSTmZkm9CGrEW3kJG8Du_THFSNX0fE49y97wElfXzANkfewhp-LuMtyPqZD8P4DWwCg/exec';


let scanner = null;
let scannedAwbs = [];
let scanLock = false;

let photoStream = null;
let photoBase64 = '';

let audioContext = null;


/* ============================================
START
============================================ */

document.addEventListener(
  'DOMContentLoaded',
  function() {

    setToday();
    loadVendors();

  }
);


function setToday() {

  const now = new Date();

  const y =
    now.getFullYear();

  const m =
    String(
      now.getMonth() + 1
    ).padStart(2,'0');

  const d =
    String(
      now.getDate()
    ).padStart(2,'0');

  document.getElementById(
    'tanggalPickup'
  ).value =
    y + '-' + m + '-' + d;
}


/* ============================================
VENDOR
============================================ */

function loadVendors() {

  const callbackName =
    'vendorCallback_' +
    Date.now();


  const script =
    document.createElement(
      'script'
    );


  window[callbackName] =
    function(result) {

      const select =
        document.getElementById(
          'vendor'
        );

      select.innerHTML =
        '<option value="">-- Pilih Vendor --</option>';


      if (
        result &&
        result.success &&
        Array.isArray(
          result.vendors
        )
      ) {

        result.vendors.forEach(
          function(vendor) {

            const option =
              document.createElement(
                'option'
              );

            option.value =
              vendor;

            option.textContent =
              vendor;

            select.appendChild(
              option
            );

          }
        );

      } else {

        showStatus(
          result?.message ||
          'Vendor gagal dimuat.',
          'error'
        );

      }


      delete window[
        callbackName
      ];


      script.remove();

    };


  script.onerror =
    function() {

      const select =
        document.getElementById(
          'vendor'
        );

      select.innerHTML =
        '<option value="">Vendor gagal dimuat</option>';

      showStatus(
        'Vendor gagal dimuat. Pastikan Apps Script sudah deploy versi terbaru.',
        'error'
      );

    };


  script.src =
    API_URL +
    '?action=getVendors' +
    '&callback=' +
    callbackName +
    '&nocache=' +
    Date.now();


  document.body.appendChild(
    script
  );

}


/* ============================================
KAMERA FOTO DRIVER
============================================ */

async function openPhotoCamera() {

  clearStatus();

  /*
  Scanner harus dimatikan dulu
  karena HP biasanya tidak bisa memakai
  kamera untuk dua proses sekaligus.
  */
  if (scanner) {
    await stopScanner();
  }


  /*
  Tutup stream foto lama.
  */
  closePhotoCamera();


  if (
    !navigator.mediaDevices ||
    !navigator.mediaDevices.getUserMedia
  ) {

    showStatus(
      'Browser tidak mendukung kamera langsung.',
      'error'
    );

    return;
  }


  try {

    photoStream =
      await navigator.mediaDevices
        .getUserMedia({

          video: {
            facingMode: {
              ideal: 'environment'
            }
          },

          audio: false

        });


    const video =
      document.getElementById(
        'photoVideo'
      );


    video.srcObject =
      photoStream;


    await video.play();


    document.getElementById(
      'photoCameraBox'
    ).style.display =
      'block';


    document.getElementById(
      'btnOpenPhoto'
    ).style.display =
      'none';


    showStatus(
      'Kamera Driver aktif.',
      'info'
    );


  } catch(error) {

    console.error(error);


    showStatus(
      'Kamera tidak dapat dibuka. Izinkan akses kamera pada Chrome.',
      'error'
    );

  }

}


function captureDriverPhoto() {

  const video =
    document.getElementById(
      'photoVideo'
    );


  if (
    !video.videoWidth ||
    !video.videoHeight
  ) {

    showStatus(
      'Kamera belum siap. Tunggu sebentar.',
      'error'
    );

    return;
  }


  const canvas =
    document.createElement(
      'canvas'
    );


  let width =
    video.videoWidth;

  let height =
    video.videoHeight;


  const maxWidth =
    1280;


  if (width > maxWidth) {

    height =
      Math.round(
        height *
        maxWidth /
        width
      );

    width =
      maxWidth;
  }


  canvas.width =
    width;

  canvas.height =
    height;


  const ctx =
    canvas.getContext(
      '2d'
    );


  ctx.drawImage(
    video,
    0,
    0,
    width,
    height
  );


  photoBase64 =
    canvas.toDataURL(
      'image/jpeg',
      0.72
    );


  document.getElementById(
    'photoPreview'
  ).src =
    photoBase64;


  document.getElementById(
    'photoPreviewBox'
  ).style.display =
    'block';


  closePhotoCamera();


  showStatus(
    '✅ Foto Driver berhasil diambil.',
    'success'
  );

}


function closePhotoCamera() {

  if (photoStream) {

    photoStream
      .getTracks()
      .forEach(
        function(track) {
          track.stop();
        }
      );

    photoStream =
      null;
  }


  const video =
    document.getElementById(
      'photoVideo'
    );


  if (video) {
    video.srcObject =
      null;
  }


  document.getElementById(
    'photoCameraBox'
  ).style.display =
    'none';


  document.getElementById(
    'btnOpenPhoto'
  ).style.display =
    'block';

}


/* ============================================
SCANNER AWB
============================================ */

async function startScanner() {

  clearStatus();


  /*
  Aktifkan audio melalui klik pengguna.
  Ini penting agar Chrome mengizinkan beep.
  */
  try {

    if (!audioContext) {

      audioContext =
        new (
          window.AudioContext ||
          window.webkitAudioContext
        )();

    }


    if (
      audioContext.state ===
      'suspended'
    ) {

      await audioContext.resume();

    }

  } catch(error) {
    console.log(error);
  }


  closePhotoCamera();


  if (scanner) {
    return;
  }


  try {

    const cameras =
      await Html5Qrcode.getCameras();


    if (
      !cameras ||
      cameras.length === 0
    ) {

      throw new Error(
        'Kamera tidak ditemukan.'
      );

    }


    let cameraId =
      cameras[
        cameras.length - 1
      ].id;


    const rearCamera =
      cameras.find(
        camera =>
          /back|rear|environment/i
            .test(camera.label)
      );


    if (rearCamera) {

      cameraId =
        rearCamera.id;

    }


    scanner =
      new Html5Qrcode(
        'reader'
      );


    await scanner.start(

      cameraId,

      {
        fps: 12,

        qrbox:
          function(
            width,
            height
          ) {

            let boxWidth =
              Math.floor(
                width * 0.90
              );

            if (
              boxWidth > 380
            ) {
              boxWidth = 380;
            }

            return {
              width: boxWidth,
              height: 140
            };

          }
      },

      onScanSuccess,

      function() {}

    );


    document.getElementById(
      'btnStartScanner'
    ).style.display =
      'none';


    document.getElementById(
      'btnStopScanner'
    ).style.display =
      'block';


    showStatus(
      'Scanner aktif. Arahkan barcode AWB ke kotak kamera.',
      'info'
    );


  } catch(error) {

    console.error(error);


    scanner =
      null;


    showStatus(
      'Scanner gagal dibuka. Pastikan izin kamera Chrome aktif.',
      'error'
    );

  }

}


function onScanSuccess(
  decodedText
) {

  if (scanLock) {
    return;
  }


  const awb =
    String(
      decodedText || ''
    ).trim();


  if (!awb) {
    return;
  }


  scanLock =
    true;


  if (
    scannedAwbs.includes(
      awb
    )
  ) {

    duplicateSound();

    vibrateDuplicate();


    showStatus(
      '⚠ AWB sudah pernah discan: ' +
      awb,
      'error'
    );


  } else {

    scannedAwbs.push(
      awb
    );


    renderAwbs();


    scanSound();


    if (
      navigator.vibrate
    ) {

      navigator.vibrate(
        130
      );

    }


    showStatus(
      '✅ SCAN BERHASIL: ' +
      awb,
      'success'
    );

  }


  setTimeout(
    function() {

      scanLock =
        false;

    },
    1000
  );

}


async function stopScanner() {

  if (!scanner) {
    return;
  }


  try {

    await scanner.stop();

    scanner.clear();

  } catch(error) {
    console.log(error);
  }


  scanner =
    null;


  document.getElementById(
    'btnStartScanner'
  ).style.display =
    'block';


  document.getElementById(
    'btnStopScanner'
  ).style.display =
    'none';

}


/* ============================================
SUARA
============================================ */

function scanSound() {

  try {

    if (!audioContext) {

      audioContext =
        new (
          window.AudioContext ||
          window.webkitAudioContext
        )();

    }


    const oscillator =
      audioContext
        .createOscillator();


    const gain =
      audioContext
        .createGain();


    oscillator.connect(
      gain
    );


    gain.connect(
      audioContext.destination
    );


    oscillator.type =
      'sine';


    oscillator.frequency
      .setValueAtTime(
        1100,
        audioContext.currentTime
      );


    gain.gain
      .setValueAtTime(
        0.32,
        audioContext.currentTime
      );


    gain.gain
      .exponentialRampToValueAtTime(
        0.01,
        audioContext.currentTime +
        0.16
      );


    oscillator.start();


    oscillator.stop(
      audioContext.currentTime +
      0.17
    );


  } catch(error) {
    console.log(error);
  }

}


function duplicateSound() {

  try {

    if (!audioContext) {
      return;
    }


    const oscillator =
      audioContext
        .createOscillator();


    const gain =
      audioContext
        .createGain();


    oscillator.connect(
      gain
    );


    gain.connect(
      audioContext.destination
    );


    oscillator.frequency.value =
      350;


    gain.gain.value =
      0.20;


    oscillator.start();


    oscillator.stop(
      audioContext.currentTime +
      0.22
    );


  } catch(error) {}

}


function vibrateDuplicate() {

  if (
    navigator.vibrate
  ) {

    navigator.vibrate([
      100,
      70,
      100
    ]);

  }

}


/* ============================================
DAFTAR AWB
============================================ */

function renderAwbs() {

  const list =
    document.getElementById(
      'awbList'
    );


  const counter =
    document.getElementById(
      'awbCounter'
    );


  counter.textContent =
    scannedAwbs.length +
    ' AWB';


  if (
    scannedAwbs.length === 0
  ) {

    list.innerHTML =
      '<div class="empty">Belum ada AWB yang discan.</div>';

    return;
  }


  list.innerHTML =
    '';


  scannedAwbs.forEach(
    function(
      awb,
      index
    ) {

      const row =
        document.createElement(
          'div'
        );


      row.className =
        'awb-item';


      const text =
        document.createElement(
          'div'
        );


      text.className =
        'awb-number';


      text.textContent =
        (index + 1) +
        '. ' +
        awb;


      const del =
        document.createElement(
          'button'
        );


      del.type =
        'button';


      del.className =
        'delete';


      del.textContent =
        'Hapus';


      del.onclick =
        function() {

          scannedAwbs.splice(
            index,
            1
          );

          renderAwbs();

        };


      row.appendChild(
        text
      );


      row.appendChild(
        del
      );


      list.appendChild(
        row
      );

    }
  );

}


function clearAwbs() {

  if (
    scannedAwbs.length === 0
  ) {
    return;
  }


  if (
    !confirm(
      'Hapus semua AWB yang sudah discan?'
    )
  ) {
    return;
  }


  scannedAwbs =
    [];


  renderAwbs();

}


/* ============================================
SIMPAN
============================================ */

async function saveData() {

  clearStatus();


  const tanggal =
    document.getElementById(
      'tanggalPickup'
    ).value;


  const driver =
    document.getElementById(
      'namaDriver'
    ).value.trim();


  const plat =
    document.getElementById(
      'platNo'
    ).value.trim();


  const vendor =
    document.getElementById(
      'vendor'
    ).value;


  if (!tanggal) {

    showStatus(
      'Tanggal Pick Up wajib diisi.',
      'error'
    );

    return;
  }


  if (!driver) {

    showStatus(
      'Nama Driver wajib diisi.',
      'error'
    );

    return;
  }


  if (!plat) {

    showStatus(
      'Plat No wajib diisi.',
      'error'
    );

    return;
  }


  if (!vendor) {

    showStatus(
      'Vendor wajib dipilih.',
      'error'
    );

    return;
  }


  if (!photoBase64) {

    showStatus(
      'Foto Driver wajib diambil.',
      'error'
    );

    return;
  }


  if (
    scannedAwbs.length === 0
  ) {

    showStatus(
      'Belum ada AWB yang discan.',
      'error'
    );

    return;
  }


  const btn =
    document.getElementById(
      'btnSave'
    );


  btn.disabled =
    true;


  btn.textContent =
    '⏳ MENYIMPAN...';


  try {

    if (scanner) {
      await stopScanner();
    }


    closePhotoCamera();


    const payload = {

      action:
        'save',

      tanggalPickup:
        tanggal,

      namaDriver:
        driver,

      platNo:
        plat,

      vendor:
        vendor,

      awbs:
        scannedAwbs,

      fotoDriver:
        photoBase64

    };


    const response =
      await fetch(

        API_URL,

        {

          method:
            'POST',

          headers: {

            'Content-Type':
              'text/plain;charset=utf-8'

          },

          body:
            JSON.stringify(
              payload
            )

        }

      );


    const text =
      await response.text();


    const result =
      JSON.parse(
        text
      );


    if (
      !result.success
    ) {

      throw new Error(
        result.message ||
        'Gagal menyimpan data.'
      );

    }


    showStatus(
      '✅ ' +
      result.jumlah +
      ' AWB BERHASIL DISIMPAN',
      'success'
    );


    scannedAwbs =
      [];


    renderAwbs();


    photoBase64 =
      '';


    document.getElementById(
      'photoPreviewBox'
    ).style.display =
      'none';


  } catch(error) {

    console.error(error);


    showStatus(
      '❌ Gagal menyimpan: ' +
      error.message,
      'error'
    );

  }


  btn.disabled =
    false;


  btn.textContent =
    '💾 SIMPAN SEMUA DATA';

}


/* ============================================
STATUS
============================================ */

function showStatus(
  message,
  type
) {

  const status =
    document.getElementById(
      'status'
    );


  status.className =
    'status ' +
    type;


  status.textContent =
    message;

}


function clearStatus() {

  const status =
    document.getElementById(
      'status'
    );


  status.className =
    'status';


  status.textContent =
    '';

}

</script>

